# Copy this file to .env and edit the values.

# Login credentials for the dashboard (change these!)
VIGILIX_ADMIN_USER=admin
VIGILIX_ADMIN_PASS=change-this-password

# Random secret used to sign the login session cookie
VIGILIX_SECRET_KEY=change-this-to-a-long-random-string

# Port the backend listens on
PORT=5000

# How many times per second to actually run YOLO on each camera. The live
# view still updates at the camera's full frame rate regardless of this
# value - only inference is throttled. 5-10 is a good range: fast enough
# to confirm an alert in well under a second, light enough that one GPU
# can cover many cameras. See OPTIMIZATION.md.
VIGILIX_DETECT_FPS=7

# Force the weapon model onto a specific device: "0" (GPU 0), "0,1"
# (multi-GPU), or "cpu". Leave unset to auto-detect (GPU if available).
# VIGILIX_WEAPON_DEVICE=0

# Input image resolution for weapon inference (default 1024 on GPU, 640 on CPU)
# VIGILIX_WEAPON_IMGSZ=1024
